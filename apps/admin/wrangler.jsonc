{
  "$schema": "../backend/node_modules/wrangler/config-schema.json",
  "name": "fc-career-top-admin",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "account_id": "65a3a715f74dc19748c243e413065b8e",
  "routes": [
    {
      "pattern": "admin.fccareer.top",
      "custom_domain": true
    }
  ],
  "main": "worker/index.ts",
  "services": [
    {
      "binding": "API",
      "service": "fc-career-top-api"
    }
  ],
  "observability": {
    "enabled": true
  }
}
