{
  "name": "@fc-career-top/backend",
  "version": "1.0.0",
  "description": "Backend for FCCareerTop",
  "main": "src/app.ts",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=10.5.0 <11"
  },
  "scripts": {
    "start": "wrangler dev --port 8888",
    "dev": "wrangler dev --port 8888",
    "build": "wrangler deploy --dry-run --outdir dist-worker",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "start:prod": "wrangler dev --port 8888",
    "db:migrate": "wrangler d1 migrations apply fc-career-top --local",
    "db:validate": "wrangler d1 migrations list fc-career-top --local",
    "db:info": "wrangler d1 migrations list fc-career-top --local",
    "dev:node": "nodemon --watch src --ext ts --exec ts-node src/app.ts",
    "build:node": "tsc",
    "start:node": "ts-node src/app.ts",
    "start:node:prod": "node dist/src/app.js",
    "db:migrate:mysql": "node scripts/flyway.cjs migrate",
    "db:validate:mysql": "node scripts/flyway.cjs validate",
    "db:info:mysql": "node scripts/flyway.cjs info",
    "db:migrate:remote": "wrangler d1 migrations apply fc-career-top --remote",
    "deploy": "wrangler deploy",
    "test:integration": "node tests/worker.integration.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VeejaLiu/FC-Career-Top.git",
    "directory": "apps/backend"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/VeejaLiu/FC-Career-Top/issues"
  },
  "homepage": "https://github.com/VeejaLiu/FC-Career-Top#readme",
  "dependencies": {
    "@sequelize/sqlite3": "7.0.0-alpha.45",
    "async-lock": "^1.4.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.0.0",
    "express-basic-auth": "^1.2.1",
    "express-session": "^1.18.1",
    "express-status-monitor": "^1.3.4",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.5.47",
    "mysql": "^2.18.1",
    "mysql2": "^3.12.0",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.1.9",
    "resend": "^4.1.2",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261009.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.19.1",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.14",
    "@typescript-eslint/eslint-plugin": "8.25.0",
    "@typescript-eslint/parser": "8.25.0",
    "eslint": "9.21.0",
    "eslint-config-prettier": "10.0.2",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.2.3",
    "eslint-plugin-promise": "7.2.1",
    "prettier": "^3.5.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.3",
    "wrangler": "4.149.0"
  },
  "private": true
}
