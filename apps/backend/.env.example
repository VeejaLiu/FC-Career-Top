APP_NAME=FC Career Top
APP_SCHEMA=http
APP_HOST=localhost
APP_PORT=8888
APP_ROUTE_PREFIX=/api
APP_BANNER=true
APP_ENV=development
APP_BACKEND_URL=http://localhost:8888/api

LOG_LEVEL=debug
LOG_JSON=false
LOG_OUTPUT=dev

MONITOR_ENABLED=false
MONITOR_ROUTE=/monitor
MONITOR_USERNAME=admin
MONITOR_PASSWORD=replace-with-a-local-monitor-password

SECRET_JWT=replace-with-a-long-random-local-secret

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=fcd
MYSQL_USERNAME=root
MYSQL_PASSWORD=replace-with-your-local-mysql-password
MYSQL_LOGGING=false

RESEND_API_KEY=re_replace_with_your_resend_api_key
