{
  "name": "@fc-career-top/website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3002",
    "build": "next build",
    "start": "pnpm --filter @fc-career-top/backend exec wrangler dev --config ../website/wrangler.jsonc --port 3002",
    "lint": "eslint .",
    "buildAndStart": "pnpm build && pnpm start",
    "typecheck": "tsc --noEmit",
    "generate:social-image": "node scripts/generate-social-image.mjs",
    "test:redirects": "node --test workers/redirect.test.mjs"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=10.5.0 <11"
  },
  "dependencies": {
    "@next/third-parties": "^15.1.3",
    "axios": "^1.7.9",
    "lodash": "^4.17.21",
    "next": "^15.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@types/lodash": "^4.17.13",
    "@types/node": "^24.19.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "daisyui": "^4.12.23",
    "eslint": "^9",
    "eslint-config-next": "15.1.2",
    "postcss": "^8",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VeejaLiu/FC-Career-Top.git",
    "directory": "apps/website"
  }
}
